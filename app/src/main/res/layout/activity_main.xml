<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/localRenderer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <LinearLayout
        android:id="@+id/hudLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="#88000000"
        android:layout_margin="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tvAccel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Acel: --"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:fontFamily="monospace"/>

        <TextView
            android:id="@+id/tvGyro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gyro: --"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:layout_marginTop="4dp"/>

        <TextView
            android:id="@+id/tvGps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GPS: --"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:layout_marginTop="4dp"/>

<!--        <TextView-->
<!--            android:id="@+id/tvMotion"-->
<!--            android:layout_width="wrap_content"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:text="Movimento: &#45;&#45;"-->
<!--            android:textColor="#FFFFFF"-->
<!--            android:textSize="14sp"-->
<!--            android:fontFamily="monospace"-->
<!--            android:layout_marginTop="4dp"/>-->

        <TextView
            android:id="@+id/tvActivity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Estado: --"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:layout_marginTop="4dp"/>

<!--        <TextView-->
<!--            android:id="@+id/tvFall"-->
<!--            android:layout_width="wrap_content"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:text="Queda: Nenhuma"-->
<!--            android:textColor="#FFFFFF"-->
<!--            android:textSize="14sp"-->
<!--            android:fontFamily="monospace"-->
<!--            android:layout_marginTop="4dp"/>-->

    </LinearLayout>

    <Button
        android:id="@+id/btnLeaveMission"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Leave Mission"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/btnStream"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/btnStream"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Iniciar stream"
        android:layout_marginBottom="70dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>