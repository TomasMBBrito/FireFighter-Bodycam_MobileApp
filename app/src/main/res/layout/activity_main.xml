<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Preview da câmara -->
    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/localRenderer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <!-- HUD sobrepostos no vídeo -->
    <LinearLayout
        android:id="@+id/hudLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="#88000000"
        android:layout_margin="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tvTemperature"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Temp: --"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:fontFamily="monospace"/>

        <TextView
            android:id="@+id/tvHeartRate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ECG: --"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:layout_marginTop="4dp"/>

        <TextView
            android:id="@+id/tvMotion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Movimento: --"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:layout_marginTop="4dp"/>

        <TextView
            android:id="@+id/tvEcg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📈 ECG: --"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:layout_marginTop="4dp"/>

        <TextView
            android:id="@+id/tvAccel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📐 Acel: --"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:layout_marginTop="4dp"/>

        <TextView
            android:id="@+id/tvGyro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔄 Gyro: --"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:layout_marginTop="4dp"/>

        <TextView
            android:id="@+id/tvGps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📍 GPS: --"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:layout_marginTop="4dp"/>

        <TextView
            android:id="@+id/tvActivity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🏃 Estado: --"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:layout_marginTop="4dp"/>

    </LinearLayout>

    <!-- Botão stream em baixo -->
    <Button
        android:id="@+id/btnStream"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Iniciar stream"
        android:layout_margin="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>